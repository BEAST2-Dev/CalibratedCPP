<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- No <parent>. We used to inherit io.github.linguaphylo:lphybeast-root; the versions it
         supplied are declared in this file's <properties> below instead. -->
    <groupId>io.github.beast2-dev</groupId>
    <artifactId>calibratedcpp-root</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>calibratedcpp-root</name>
    <description>Calibrated Coalescent Point Process (Calibrated CPP) for BEAST 3. The CPP is a
        model of ultrametric trees where node ages are i.i.d. random variables, capturing
        birth-death processes with time-dependent birth and death rates and age-dependent death
        rates.</description>
    <url>https://github.com/BEAST2-Dev/CalibratedCPP</url>

    <licenses>
        <license>
            <name>GNU Lesser General Public License v2.1</name>
            <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Marcus Overwater</name>
            <url>https://github.com/moverwater</url>
        </developer>
        <developer>
            <name>Eva Yutong Li</name>
            <url>https://github.com/EvaLiyt</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/BEAST2-Dev/CalibratedCPP.git</connection>
        <developerConnection>scm:git:ssh://github.com/BEAST2-Dev/CalibratedCPP.git</developerConnection>
        <url>https://github.com/BEAST2-Dev/CalibratedCPP</url>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/BEAST2-Dev/CalibratedCPP</url>
        </repository>
    </distributionManagement>


    <properties>
        <lphy.vision>1.8.0-beta1</lphy.vision>
        <lphybeast.vision>1.4.0-beta1</lphybeast.vision>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- BEAST3 core and external BEAST2 package versions shared across modules -->
        <beast.version>2.8.0-beta7</beast.version>
        <beast.labs.version>2.1.0-beta2</beast.labs.version>
        <substmodels.version>1.3.2</substmodels.version>
        <beast.orc.version>1.3.1</beast.orc.version>
        <junit.version>5.10.2</junit.version>
        <hipparchus.version>4.0.1</hipparchus.version>
        <jtransforms.version>3.1</jtransforms.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.hipparchus</groupId>
                <artifactId>hipparchus-core</artifactId>
                <version>${hipparchus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.wendykierp</groupId>
                <artifactId>JTransforms</artifactId>
                <version>${jtransforms.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>calibratedcpp-beast</module>
        <module>calibratedcpp-lphy</module>
        <module>calibratedcpp-lphy-studio</module>
        <module>calibratedcpp-lphybeast</module>
        <module>calibratedcpp-lphybeast-launcher</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>